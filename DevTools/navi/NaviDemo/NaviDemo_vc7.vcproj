<?xml version="1.0" encoding="Windows-1252"?>
<VisualStudioProject
	ProjectType="Visual C++"
	Version="7.10"
	Name="NaviDemo_vc7"
	ProjectGUID="{D8576C15-749A-42BB-8536-51C10F7ECF7F}"
	Keyword="Win32Proj">
	<Platforms>
		<Platform
			Name="Win32"/>
	</Platforms>
	<Configurations>
		<Configuration
			Name="Debug|Win32"
			OutputDirectory="$(ProjectDir)Bin\$(ConfigurationName)_vc7"
			IntermediateDirectory="$(ProjectDir)Objects_vc7\$(ConfigurationName)"
			ConfigurationType="1"
			CharacterSet="2">
			<Tool
				Name="VCCLCompilerTool"
				Optimization="0"
				AdditionalIncludeDirectories="&quot;$(ProjectDir)Headers&quot;;&quot;$(SolutionDir)..\..\Dependencies\navi\include&quot;;&quot;$(OGRE_HOME)\OgreMain\include&quot;;&quot;$(OGRE_HOME)\Dependencies\include&quot;"
				PreprocessorDefinitions="WIN32;_DEBUG;_WINDOWS"
				MinimalRebuild="TRUE"
				BasicRuntimeChecks="3"
				RuntimeLibrary="3"
				TreatWChar_tAsBuiltInType="TRUE"
				UsePrecompiledHeader="0"
				WarningLevel="3"
				Detect64BitPortabilityProblems="TRUE"
				DebugInformationFormat="4"/>
			<Tool
				Name="VCCustomBuildTool"/>
			<Tool
				Name="VCLinkerTool"
				AdditionalDependencies="OgreMain_d.lib Navi_d.lib llmozlib_d.lib OIS_d.lib"
				OutputFile="$(OutDir)\NaviDemo.exe"
				LinkIncremental="1"
				AdditionalLibraryDirectories="&quot;$(SolutionDir)..\..\Dependencies\navi\lib_vc7&quot;;&quot;$(SolutionDir)..\..\Dependencies\llmozlib\win32_vc7\lib&quot;;&quot;$(OGRE_HOME)\lib&quot;;&quot;$(OGRE_HOME)\Dependencies\lib\Debug&quot;"
				IgnoreAllDefaultLibraries="FALSE"
				IgnoreDefaultLibraryNames=""
				GenerateDebugInformation="TRUE"
				ProgramDatabaseFile="$(OutDir)/NaviDemo_vc7.pdb"
				SubSystem="0"
				TargetMachine="1"/>
			<Tool
				Name="VCMIDLTool"/>
			<Tool
				Name="VCPostBuildEventTool"
				Description="Copying debug runtime files ..."
				CommandLine="if not exist &quot;$(TargetDir)\components\&quot; xcopy &quot;$(SolutionDir)..\..\Dependencies\llmozlib\win32_vc7\runtime\Debug\*.*&quot; &quot;$(TargetDir)&quot; /s /y
if not exist &quot;$(TargetDir)\OgreMain_d.dll&quot; xcopy &quot;$(OGRE_HOME)\Samples\Common\bin\Debug\*.dll&quot; &quot;$(TargetDir)&quot; /s /y
if not exist &quot;$(TargetDir)\NaviLocal\&quot; xcopy &quot;$(ProjectDir)Bin\Build-Common\*.*&quot; &quot;$(TargetDir)&quot; /s /y
if not exist &quot;$(TargetDir)\NaviLocal\Navi.js&quot; xcopy &quot;$(SolutionDir)..\..\Dependencies\navi\Javascript\*.*&quot; &quot;$(TargetDir)\NaviLocal\&quot; /y
if not exist &quot;$(TargetDir)\Plugins.cfg&quot; xcopy &quot;$(OGRE_HOME)\Samples\Common\bin\Debug\Plugins.cfg&quot; &quot;$(TargetDir)&quot; /s /y
if not exist &quot;$(TargetDir)\quake3settings.cfg&quot; xcopy &quot;$(OGRE_HOME)\Samples\Common\bin\Debug\quake3settings.cfg&quot; &quot;$(TargetDir)&quot; /s /y
"/>
			<Tool
				Name="VCPreBuildEventTool"/>
			<Tool
				Name="VCPreLinkEventTool"/>
			<Tool
				Name="VCResourceCompilerTool"/>
			<Tool
				Name="VCWebServiceProxyGeneratorTool"/>
			<Tool
				Name="VCXMLDataGeneratorTool"/>
			<Tool
				Name="VCWebDeploymentTool"/>
			<Tool
				Name="VCManagedWrapperGeneratorTool"/>
			<Tool
				Name="VCAuxiliaryManagedWrapperGeneratorTool"/>
		</Configuration>
		<Configuration
			Name="Release|Win32"
			OutputDirectory="$(ProjectDir)Bin\$(ConfigurationName)_vc7"
			IntermediateDirectory="$(ProjectDir)Objects_vc7\$(ConfigurationName)"
			ConfigurationType="1"
			CharacterSet="2">
			<Tool
				Name="VCCLCompilerTool"
				AdditionalIncludeDirectories="&quot;$(ProjectDir)Headers&quot;;&quot;$(SolutionDir)..\..\Dependencies\navi\include&quot;;&quot;$(OGRE_HOME)\OgreMain\include&quot;;&quot;$(OGRE_HOME)\Dependencies\include&quot;"
				PreprocessorDefinitions="WIN32;NDEBUG;_WINDOWS"
				RuntimeLibrary="2"
				TreatWChar_tAsBuiltInType="TRUE"
				UsePrecompiledHeader="0"
				WarningLevel="3"
				Detect64BitPortabilityProblems="TRUE"
				DebugInformationFormat="3"/>
			<Tool
				Name="VCCustomBuildTool"/>
			<Tool
				Name="VCLinkerTool"
				AdditionalDependencies="OgreMain.lib Navi.lib llmozlib.lib OIS.lib"
				OutputFile="$(OutDir)\NaviDemo.exe"
				LinkIncremental="1"
				AdditionalLibraryDirectories="&quot;$(SolutionDir)..\..\Dependencies\navi\lib_vc7&quot;;&quot;$(SolutionDir)..\..\Dependencies\llmozlib\win32_vc7\lib&quot;;&quot;$(OGRE_HOME)\lib&quot;;&quot;$(OGRE_HOME)\Dependencies\lib\Release&quot;"
				GenerateDebugInformation="TRUE"
				SubSystem="0"
				OptimizeReferences="2"
				EnableCOMDATFolding="2"
				TargetMachine="1"/>
			<Tool
				Name="VCMIDLTool"/>
			<Tool
				Name="VCPostBuildEventTool"
				Description="Copying release runtime files ..."
				CommandLine="if not exist &quot;$(TargetDir)\components\&quot; xcopy &quot;$(SolutionDir)..\..\Dependencies\llmozlib\win32_vc7\runtime\Release\*.*&quot; &quot;$(TargetDir)&quot; /s /y
if not exist &quot;$(TargetDir)\OgreMain_d.dll&quot; xcopy &quot;$(OGRE_HOME)\Samples\Common\bin\Release\*.dll&quot; &quot;$(TargetDir)&quot; /s /y
if not exist &quot;$(TargetDir)\NaviLocal\&quot; xcopy &quot;$(ProjectDir)Bin\Build-Common\*.*&quot; &quot;$(TargetDir)&quot; /s /y
if not exist &quot;$(TargetDir)\NaviLocal\Navi.js&quot; xcopy &quot;$(SolutionDir)..\..\Dependencies\navi\Javascript\*.*&quot; &quot;$(TargetDir)\NaviLocal\&quot; /y
if not exist &quot;$(TargetDir)\Plugins.cfg&quot; xcopy &quot;$(OGRE_HOME)\Samples\Common\bin\Release\Plugins.cfg&quot; &quot;$(TargetDir)&quot; /s /y
if not exist &quot;$(TargetDir)\quake3settings.cfg&quot; xcopy &quot;$(OGRE_HOME)\Samples\Common\bin\Release\quake3settings.cfg&quot; &quot;$(TargetDir)&quot; /s /y
"/>
			<Tool
				Name="VCPreBuildEventTool"/>
			<Tool
				Name="VCPreLinkEventTool"/>
			<Tool
				Name="VCResourceCompilerTool"/>
			<Tool
				Name="VCWebServiceProxyGeneratorTool"/>
			<Tool
				Name="VCXMLDataGeneratorTool"/>
			<Tool
				Name="VCWebDeploymentTool"/>
			<Tool
				Name="VCManagedWrapperGeneratorTool"/>
			<Tool
				Name="VCAuxiliaryManagedWrapperGeneratorTool"/>
		</Configuration>
	</Configurations>
	<References>
	</References>
	<Files>
		<Filter
			Name="Source Files"
			Filter="cpp;c;cxx;def;odl;idl;hpj;bat;asm;asmx"
			UniqueIdentifier="{4FC737F1-C7A5-4376-A066-2A32D752A2FF}">
			<File
				RelativePath=".\Source\EntryPoint.cpp">
			</File>
			<File
				RelativePath=".\Source\InputManager.cpp">
			</File>
			<File
				RelativePath=".\Source\NaviDemo.cpp">
			</File>
		</Filter>
		<Filter
			Name="Header Files"
			Filter="h;hpp;hxx;hm;inl;inc;xsd"
			UniqueIdentifier="{93995380-89BD-4b04-88EB-625FBE52EBFB}">
			<File
				RelativePath=".\Headers\InputManager.h">
			</File>
			<File
				RelativePath=".\Headers\NaviDemo.h">
			</File>
		</Filter>
		<Filter
			Name="Resource Files"
			Filter="rc;ico;cur;bmp;dlg;rc2;rct;bin;rgs;gif;jpg;jpeg;jpe;resx"
			UniqueIdentifier="{67DA6AB6-F800-4c08-8B7A-83BB121AAD01}">
		</Filter>
		<File
			RelativePath=".\readme.txt">
