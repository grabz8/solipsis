if not exist &quot;$(ProjectDir)..\..\..\Dependencies\llmozlib\win32_vc7\lib\llmozlib_d.lib&quot; copy &quot;$(ProjectDir)..\..\..\DevTools\llmozlib\Debug_vc7\llmozlib_vc7.lib&quot; &quot;$(ProjectDir)..\..\..\Dependencies\llmozlib\win32_vc7\lib\llmozlib_d.lib&quot; /y
if not exist &quot;$(ProjectDir)..\..\..\Dependencies\llmozlib\win32_vc7\runtime\Debug\xul.dll&quot; xcopy &quot;$(ProjectDir)..\..\..\DevTools\llmozlib\libraries\i686-win32\runtime_debug\*.*&quot; &quot;$(ProjectDir)..\..\..\Dependencies\llmozlib\win32_vc7\runtime\Debug&quot; /s /y
"/>
