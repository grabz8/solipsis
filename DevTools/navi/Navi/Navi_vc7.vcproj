if not exist &quot;$(ProjectDir)..\..\..\Dependencies\navi\Javascript&quot; mkdir &quot;$(ProjectDir)..\..\..\Dependencies\navi\Javascript&quot;
copy &quot;Include\*.h&quot; &quot;$(ProjectDir)..\..\..\Dependencies\navi\include\.&quot; /y
copy &quot;lib_vc7\navi_d.lib&quot; &quot;$(ProjectDir)..\..\..\Dependencies\navi\lib_vc7\.&quot; /y
copy &quot;Javascript\Navi.js&quot; &quot;$(ProjectDir)..\..\..\Dependencies\navi\Javascript\.&quot; /y
"/>
			<Tool
				Name="VCPreBuildEventTool"
				Description="Copying LLMozLib debug dependencies ..."
