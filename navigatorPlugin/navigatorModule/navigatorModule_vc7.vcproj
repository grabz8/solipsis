				Name="VCPostBuildEventTool"
				Description="Copying debug runtime files ..."
				CommandLine="if not exist &quot;$(ProjectDir)..\..\Dependencies\navigatorModule\include&quot; mkdir $(ProjectDir)..\..\Dependencies\navigatorModule\include
copy NavigatorModule.h $(ProjectDir)..\..\Dependencies\navigatorModule\include\. /y
copy I*.h $(ProjectDir)..\..\Dependencies\navigatorModule\include\. /y
if not exist &quot;$(ProjectDir)..\..\Dependencies\navigatorModule\debugdll&quot; mkdir $(ProjectDir)..\..\Dependencies\navigatorModule\debugdll
copy $(OutDir)\$(TargetFileName) $(ProjectDir)..\..\Dependencies\navigatorModule\debugdll\. /y
copy $(OutDir)\$(TargetFileName) $(ProjectDir)..\..\Common\bin\navigator\debug\. /y
"/>
