			<Tool
				Name="VCMIDLTool"/>
			<Tool
				Name="VCPostBuildEventTool"
				Description="Copying release runtime files ..."
				CommandLine="if not exist &quot;$(ProjectDir)..\Dependencies\MdlrTools\include&quot; mkdir &quot;$(ProjectDir)..\Dependencies\MdlrTools\include&quot;
xcopy &quot;$(ProjectDir)include\*.h&quot; &quot;$(ProjectDir)..\Dependencies\MdlrTools\include\.&quot; /y
