				OutputFile="$(OutDir)/Navigator.dll"
				LinkIncremental="2"
				AdditionalLibraryDirectories="..\Dependencies\pthreads\lib;&quot;..\Dependencies\xmlrpc++\lib&quot;;..\Dependencies\tinyxml\lib;..\Dependencies\llmozlib\win32_vc7\lib;&quot;$(OGRE_HOME)\lib&quot;;&quot;$(OGRE_HOME)\Dependencies\lib\$(ConfigurationName)&quot;;..\Dependencies\navi\lib_vc7;..\Dependencies\lua\lib\debuglib;..\Dependencies\OgreOde\lib;&quot;$(PHYSX_DIR)\SDKs\lib\win32&quot;;..\Dependencies\tokamak\lib\debugdll"
