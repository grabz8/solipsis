
material gunsdoors
{
	technique
	{
		pass
		{
			ambient 0 0 0 1
			specular 0 0 0 1 46.6622
			alpha_rejection greater 128

			texture_unit
			{
				texture_alias Texture #1
				texture gunsdoors.bmp
			}
		}

	}

}

