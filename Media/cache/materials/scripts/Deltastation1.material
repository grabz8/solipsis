material DS_mat05/ogre_glass
{
	technique
	{
		pass
		{
			ambient 0.3 0.3 0.9 1
			diffuse 0.3 0.3 0.9 1
			specular 0.2 0.2 0.2 1 10
			emissive 0.294118 0.294118 0.294118 1
			cull_hardware none
			cull_software none
scene_blend add
depth_write off 

			texture_unit
			{
				texture_alias Texture #8
				texture deltaglass.bmp
env_map spherical 				
			}
		}

	}

}

