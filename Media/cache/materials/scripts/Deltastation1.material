
material DS_mat09/DS_mat10
{
	technique
	{
		pass
		{
			ambient 0 0 0 1
			specular 0 0 0 1 10

			texture_unit
			{
				texture_alias Texture #37
				texture boite3.jpg
				tex_coord_set 2
			}
		}

	}

}

material DS_mat09/Matériau_#15
{
	technique
	{
		pass
		{
			ambient 0.588 0.588 0.588 1
			diffuse 0.588 0.588 0.588 1
			specular 0 0 0 1 10
		}

	}

}

material DS_mat08/ogre_DS_mat03
{
	technique
	{
		pass
		{
			ambient 0 0 0 1
			specular 0.215686 0.215686 0.215686 1 46.6622
			emissive 0.294118 0.294118 0.294118 1

			texture_unit
			{
				texture_alias Texture #4
				texture deltacolor.bmp
			}
		}

	}

}

