
material Ile_nelBASSIN
{
	technique
	{
		pass
		{
			ambient 0 0 0 1
			specular 0 0 0 1 10
			emissive 0.588235 0.588235 0.588235 1
			alpha_rejection greater 128
			cull_hardware none
			cull_software none

			texture_unit
			{
				texture_alias Texture #218
				texture O_ail_02_bassin.jpg
				tex_coord_set 2
			}
		}

	}

}

