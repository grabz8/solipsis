<?xml version="1.0" encoding="Windows-1252"?>
<VisualStudioProject
	ProjectType="Visual C++"
	Version="8,00"
	Name="SWFPlugin"
	ProjectGUID="{C477314D-972B-4524-95C3-25DA9471A3C3}"
	RootNamespace="SWFPlugin"
	Keyword="Win32Proj"
	>
	<Platforms>
		<Platform
			Name="Win32"
		/>
	</Platforms>
	<ToolFiles>
	</ToolFiles>
	<Configurations>
		<Configuration
			Name="Debug|Win32"
			OutputDirectory="$(ProjectDir)$(ConfigurationName)"
			IntermediateDirectory="$(ProjectDir)$(ConfigurationName)"
			ConfigurationType="2"
			CharacterSet="2"
			>
			<Tool
				Name="VCPreBuildEventTool"
				Description="Copying SWF dependencies ..."
				CommandLine="if not exist &quot;$(ProjectDir)..\Dependencies\swf\include&quot; mkdir &quot;$(ProjectDir)..\Dependencies\swf\include&quot;&#x0D;&#x0A;if not exist &quot;$(ProjectDir)..\Dependencies\swf\lib&quot; mkdir &quot;$(ProjectDir)..\Dependencies\swf\lib&quot;&#x0D;&#x0A;if not exist &quot;$(ProjectDir)..\Dependencies\swf\runtime\plugins&quot; mkdir &quot;$(ProjectDir)..\Dependencies\swf\runtime\plugins&quot;&#x0D;&#x0A;xcopy &quot;$(ProjectDir)..\DevTools\swf\libraries\i686-win32\include\*.*&quot; &quot;$(ProjectDir)..\Dependencies\swf\include&quot; /s /y&#x0D;&#x0A;copy &quot;$(ProjectDir)..\DevTools\swf\libraries\i686-win32\lib\libswf.lib&quot; &quot;$(ProjectDir)..\Dependencies\swf\lib&quot; /y&#x0D;&#x0A;copy &quot;$(ProjectDir)..\DevTools\swf\libraries\i686-win32\runtime\libswf.dll&quot; &quot;$(ProjectDir)..\Dependencies\swf\runtime&quot; /y&#x0D;&#x0A;if not exist &quot;$(ProjectDir)..\Dependencies\swf\runtime\plugins\libvmem_plugin.dll&quot; xcopy &quot;$(ProjectDir)..\DevTools\swf\libraries\i686-win32\runtime\plugins\*.*&quot; &quot;$(ProjectDir)..\Dependencies\swf\runtime\plugins&quot; /s /y&#x0D;&#x0A;"
			/>
			<Tool
				Name="VCCustomBuildTool"
			/>
			<Tool
				Name="VCXMLDataGeneratorTool"
			/>
			<Tool
				Name="VCWebServiceProxyGeneratorTool"
			/>
			<Tool
				Name="VCMIDLTool"
			/>
			<Tool
				Name="VCCLCompilerTool"
				Optimization="0"
				AdditionalIncludeDirectories="&quot;$(OGRE_HOME)\OgreMain\include&quot;;&quot;$(OGRE_HOME)\include&quot;;..\Dependencies\pthreads\include;..\Dependencies\swf\include;..\Dependencies\navigatorModule\include"
				PreprocessorDefinitions="WIN32;_DEBUG;_WINDOWS;_USRDLL;SWFPLUGIN_EXPORTS;OGRE_SWFPLUGIN_EXPORTS"
				MinimalRebuild="true"
				BasicRuntimeChecks="3"
				RuntimeLibrary="3"
				UsePrecompiledHeader="0"
				WarningLevel="3"
				Detect64BitPortabilityProblems="true"
				DebugInformationFormat="4"
			/>
			<Tool
				Name="VCManagedResourceCompilerTool"
			/>
			<Tool
				Name="VCResourceCompilerTool"
			/>
			<Tool
				Name="VCPreLinkEventTool"
			/>
			<Tool
				Name="VCLinkerTool"
				AdditionalDependencies="OgreMain_d.lib pthreadVC_d.lib libswf.lib"
				OutputFile="$(OutDir)\Plugin_SWF_d.dll"
				LinkIncremental="2"
				AdditionalLibraryDirectories="&quot;$(OGRE_HOME)\lib&quot;;..\Dependencies\pthreads\lib;..\Dependencies\swf\lib"
				GenerateDebugInformation="true"
				SubSystem="2"
				TargetMachine="1"
			/>
			<Tool
				Name="VCALinkTool"
			/>
			<Tool
				Name="VCManifestTool"
			/>
			<Tool
				Name="VCXDCMakeTool"
			/>
			<Tool
				Name="VCBscMakeTool"
			/>
			<Tool
				Name="VCFxCopTool"
			/>
			<Tool
				Name="VCAppVerifierTool"
			/>
			<Tool
				Name="VCWebDeploymentTool"
			/>
			<Tool
				Name="VCPostBuildEventTool"
				Description="Copying debug runtime files and Adding plugin into Plugins.cfg"
				CommandLine="copy &quot;$(ProjectDir)..\Dependencies\swf\runtime\libswf.dll&quot; &quot;$(ProjectDir)..\Common\bin\navigator\$(ConfigurationName)&quot; /y&#x0D;&#x0A;if not exist &quot;$(ProjectDir)..\Common\bin\navigator\$(ConfigurationName)\SWFplugins&quot; mkdir &quot;$(ProjectDir)..\Common\bin\navigator\$(ConfigurationName)\SWFplugins&quot;&#x0D;&#x0A;if not exist &quot;$(ProjectDir)..\Common\bin\navigator\$(ConfigurationName)\SWFplugins\libvmem_plugin.dll&quot; xcopy &quot;$(ProjectDir)..\Dependencies\swf\runtime\plugins\*.*&quot; &quot;$(ProjectDir)..\Common\bin\navigator\$(ConfigurationName)\SWFplugins&quot; /s /y&#x0D;&#x0A;copy &quot;$(OutDir)\$(TargetFileName)&quot; &quot;$(ProjectDir)..\Common\bin\navigator\$(ConfigurationName)&quot; /y&#x0D;&#x0A;$(ProjectDir)..\Common\addIntoCfg.bat &quot;Plugin=$(TargetFileName)&quot; &quot;$(ProjectDir)..\Common\bin\navigator\$(ConfigurationName)\plugins.cfg&quot;&#x0D;&#x0A;"
			/>
		</Configuration>
		<Configuration
			Name="Release|Win32"
			OutputDirectory="$(ProjectDir)$(ConfigurationName)"
			IntermediateDirectory="$(ProjectDir)$(ConfigurationName)"
			ConfigurationType="2"
			CharacterSet="2"
			WholeProgramOptimization="1"
			>
			<Tool
				Name="VCPreBuildEventTool"
				Description="Copying SWF dependencies ..."
				CommandLine="if not exist &quot;$(ProjectDir)..\Dependencies\swf\include&quot; mkdir &quot;$(ProjectDir)..\Dependencies\swf\include&quot;&#x0D;&#x0A;if not exist &quot;$(ProjectDir)..\Dependencies\swf\lib&quot; mkdir &quot;$(ProjectDir)..\Dependencies\swf\lib&quot;&#x0D;&#x0A;if not exist &quot;$(ProjectDir)..\Dependencies\swf\runtime\plugins&quot; mkdir &quot;$(ProjectDir)..\Dependencies\swf\runtime\plugins&quot;&#x0D;&#x0A;xcopy &quot;$(ProjectDir)..\DevTools\swf\libraries\i686-win32\include\*.*&quot; &quot;$(ProjectDir)..\Dependencies\swf\include&quot; /s /y&#x0D;&#x0A;copy &quot;$(ProjectDir)..\DevTools\swf\libraries\i686-win32\lib\libswf.lib&quot; &quot;$(ProjectDir)..\Dependencies\swf\lib&quot; /y&#x0D;&#x0A;copy &quot;$(ProjectDir)..\DevTools\swf\libraries\i686-win32\runtime\libswf.dll&quot; &quot;$(ProjectDir)..\Dependencies\swf\runtime&quot; /y&#x0D;&#x0A;if not exist &quot;$(ProjectDir)..\Dependencies\swf\runtime\plugins\libvmem_plugin.dll&quot; xcopy &quot;$(ProjectDir)..\DevTools\swf\libraries\i686-win32\runtime\plugins\*.*&quot; &quot;$(ProjectDir)..\Dependencies\swf\runtime\plugins&quot; /s /y&#x0D;&#x0A;"
			/>
			<Tool
				Name="VCCustomBuildTool"
			/>
			<Tool
				Name="VCXMLDataGeneratorTool"
			/>
			<Tool
				Name="VCWebServiceProxyGeneratorTool"
			/>
			<Tool
				Name="VCMIDLTool"
			/>
			<Tool
				Name="VCCLCompilerTool"
				AdditionalIncludeDirectories="&quot;$(OGRE_HOME)\OgreMain\include&quot;;&quot;$(OGRE_HOME)\include&quot;;..\Dependencies\pthreads\include;..\Dependencies\swf\include;..\Dependencies\navigatorModule\include"
				PreprocessorDefinitions="WIN32;NDEBUG;_WINDOWS;_USRDLL;SWFPLUGIN_EXPORTS;OGRE_SWFPLUGIN_EXPORTS"
				RuntimeLibrary="2"
				UsePrecompiledHeader="0"
				WarningLevel="3"
				Detect64BitPortabilityProblems="true"
				DebugInformationFormat="3"
			/>
			<Tool
				Name="VCManagedResourceCompilerTool"
			/>
			<Tool
				Name="VCResourceCompilerTool"
			/>
			<Tool
				Name="VCPreLinkEventTool"
			/>
			<Tool
				Name="VCLinkerTool"
				AdditionalDependencies="OgreMain.lib pthreadVC.lib libswf.lib"
				OutputFile="$(OutDir)\Plugin_SWF.dll"
				LinkIncremental="1"
				AdditionalLibraryDirectories="&quot;$(OGRE_HOME)\lib&quot;;..\Dependencies\pthreads\lib;..\Dependencies\swf\lib"
				GenerateDebugInformation="true"
				SubSystem="2"
				OptimizeReferences="2"
				EnableCOMDATFolding="2"
				TargetMachine="1"
			/>
			<Tool
				Name="VCALinkTool"
			/>
			<Tool
				Name="VCManifestTool"
			/>
			<Tool
				Name="VCXDCMakeTool"
			/>
			<Tool
				Name="VCBscMakeTool"
			/>
			<Tool
				Name="VCFxCopTool"
			/>
			<Tool
				Name="VCAppVerifierTool"
			/>
			<Tool
				Name="VCWebDeploymentTool"
			/>
			<Tool
				Name="VCPostBuildEventTool"
				Description="Copying release runtime files and Adding plugin into Plugins.cfg"
				CommandLine="copy &quot;$(ProjectDir)..\Dependencies\swf\runtime\libswf.dll&quot; &quot;$(ProjectDir)..\Common\bin\navigator\$(ConfigurationName)&quot; /y&#x0D;&#x0A;if not exist &quot;$(ProjectDir)..\Common\bin\navigator\$(ConfigurationName)\SWFplugins&quot; mkdir &quot;$(ProjectDir)..\Common\bin\navigator\$(ConfigurationName)\SWFplugins&quot;&#x0D;&#x0A;if not exist &quot;$(ProjectDir)..\Common\bin\navigator\$(ConfigurationName)\SWFplugins\libvmem_plugin.dll&quot; xcopy &quot;$(ProjectDir)..\Dependencies\swf\runtime\plugins\*.*&quot; &quot;$(ProjectDir)..\Common\bin\navigator\$(ConfigurationName)\SWFplugins&quot; /s /y&#x0D;&#x0A;copy &quot;$(OutDir)\$(TargetFileName)&quot; &quot;$(ProjectDir)..\Common\bin\navigator\$(ConfigurationName)&quot; /y&#x0D;&#x0A;$(ProjectDir)..\Common\addIntoCfg.bat &quot;Plugin=$(TargetFileName)&quot; &quot;$(ProjectDir)..\Common\bin\navigator\$(ConfigurationName)\plugins.cfg&quot;&#x0D;&#x0A;"
			/>
		</Configuration>
	</Configurations>
